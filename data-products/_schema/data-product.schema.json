{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Franckypro/dataops-k8s-platform/data-products/_schema/data-product.schema.json",
  "title": "Contrat de data product",
  "description": "Un fichier YAML par table : propriétaire, schéma, niveau de service, contrôles qualité et accès.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "dataops/v1" },
    "kind": { "const": "DataProduct" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain", "title", "description", "owner"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "title": { "type": "string", "minLength": 5 },
        "description": { "type": "string", "minLength": 20 },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["team", "steward"],
          "properties": {
            "team": { "type": "string", "minLength": 2 },
            "steward": { "type": "string", "minLength": 2 }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "schema", "sla", "quality", "access"],
      "properties": {
        "table": { "type": "string", "pattern": "^iceberg\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "producedBy": { "type": "string", "description": "DAG Airflow qui alimente la table" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "licence"],
          "properties": {
            "name": { "type": "string" },
            "publisher": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "documentation": { "type": "string", "format": "uri" },
            "licence": { "type": "string" },
            "frequency": { "type": "string" }
          }
        },
        "partitioning": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "schema": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "description"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "type": { "enum": ["string", "double", "long", "boolean", "date", "timestamp"] },
              "required": { "type": "boolean" },
              "source": { "type": "string", "description": "Colonne d'origine dans la source" },
              "description": { "type": "string", "minLength": 3 }
            }
          }
        },
        "sla": {
          "type": "object",
          "additionalProperties": false,
          "required": ["refresh", "freshness_max_hours"],
          "properties": {
            "refresh": { "type": "string" },
            "freshness_max_hours": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "quality": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["not_null", "unique", "accepted_values", "range", "row_count_min", "expression"] },
              "severity": { "enum": ["error", "warn"] }
            },
            "allOf": [
              {
                "if": { "properties": { "type": { "enum": ["not_null", "unique"] } } },
                "then": {
                  "required": ["columns"],
                  "properties": { "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
                }
              },
              {
                "if": { "properties": { "type": { "const": "accepted_values" } } },
                "then": {
                  "required": ["column", "values"],
                  "properties": { "column": { "type": "string" }, "values": { "type": "array", "minItems": 1 } }
                }
              },
              {
                "if": { "properties": { "type": { "const": "range" } } },
                "then": {
                  "required": ["column"],
                  "anyOf": [{ "required": ["min"] }, { "required": ["max"] }],
                  "properties": { "column": { "type": "string" }, "min": { "type": "number" }, "max": { "type": "number" } }
                }
              },
              {
                "if": { "properties": { "type": { "const": "row_count_min" } } },
                "then": { "required": ["min"], "properties": { "min": { "type": "integer", "minimum": 1 } } }
              },
              {
                "if": { "properties": { "type": { "const": "expression" } } },
                "then": {
                  "required": ["name", "condition"],
                  "properties": {
                    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                    "condition": { "type": "string", "minLength": 3 },
                    "max_failure_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            ]
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification"],
          "properties": {
            "classification": { "enum": ["public", "interne", "confidentiel"] },
            "consumers": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
