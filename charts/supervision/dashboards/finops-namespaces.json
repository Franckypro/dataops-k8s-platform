{
  "uid": "dataops-finops",
  "title": "FinOps : coût par namespace",
  "description": "Coûts calculés par OpenCost avec les tarifs indicatifs de values/opencost.yaml (ressources allouées = max(réservation, consommation)).",
  "tags": ["dataops", "finops", "opencost"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Coût horaire du cluster",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(node_total_hourly_cost)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" },
      "fieldConfig": { "defaults": { "decimals": 3, "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Projection sur un mois (730 h)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(node_total_hourly_cost) * 730" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Part du coût allouée aux namespaces de la plateforme",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(container_cpu_allocation{namespace=~\"lakehouse|trino|airflow|monitoring|opencost\"} * on (node) group_left() avg by (node) (node_cpu_hourly_cost)) + sum(container_memory_allocation_bytes{namespace=~\"lakehouse|trino|airflow|monitoring|opencost\"} / 1073741824 * on (node) group_left() avg by (node) (node_ram_hourly_cost))) / sum(node_total_hourly_cost)"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Coût horaire par namespace (CPU + mémoire)",
      "gridPos": { "x": 0, "y": 4, "w": 14, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (container_cpu_allocation{namespace!=\"\"} * on (node) group_left() avg by (node) (node_cpu_hourly_cost)) + sum by (namespace) (container_memory_allocation_bytes{namespace!=\"\"} / 1073741824 * on (node) group_left() avg by (node) (node_ram_hourly_cost))",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 35 } }, "overrides": [] }
    },
    {
      "type": "bargauge",
      "title": "Coût projeté sur un mois, par namespace",
      "gridPos": { "x": 14, "y": 4, "w": 10, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "730 * (sum by (namespace) (container_cpu_allocation{namespace!=\"\"} * on (node) group_left() avg by (node) (node_cpu_hourly_cost)) + sum by (namespace) (container_memory_allocation_bytes{namespace!=\"\"} / 1073741824 * on (node) group_left() avg by (node) (node_ram_hourly_cost)))",
          "legendFormat": "{{namespace}}",
          "instant": true
        }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "table",
      "title": "Ressources allouées et consommées par namespace",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (namespace) (container_cpu_allocation{namespace!=\"\"})", "format": "table", "instant": true },
        { "refId": "B", "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\", namespace!=\"\"}[5m]))", "format": "table", "instant": true },
        { "refId": "C", "expr": "sum by (namespace) (container_memory_allocation_bytes{namespace!=\"\"})", "format": "table", "instant": true },
        { "refId": "D", "expr": "sum by (namespace) (container_memory_working_set_bytes{container!=\"\", namespace!=\"\"})", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "namespace": "Namespace",
              "Value #A": "CPU alloué (cœurs)",
              "Value #B": "CPU consommé (cœurs)",
              "Value #C": "Mémoire allouée",
              "Value #D": "Mémoire consommée"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 2 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Mémoire allouée" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "Mémoire consommée" }, "properties": [{ "id": "unit", "value": "bytes" }] }
        ]
      },
      "options": { "sortBy": [{ "displayName": "Mémoire allouée", "desc": true }] }
    }
  ]
}
